# Reverse Proxy für Kinora. ${KINORA_DOMAIN} setzt Docker beim Start ein.
# Erwartet fullchain.pem und privkey.pem in /etc/nginx/certs (z. B. von Let's Encrypt).

limit_req_zone $binary_remote_addr zone=kinora_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=kinora_auth:10m rate=60r/m;
limit_req_status 429;

upstream kinora_app {
    server app:3000;
    keepalive 32;
}

server {
    listen 80;
    server_name ${KINORA_DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${KINORA_DOMAIN};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    # Grösser als das Limit der Anwendung, damit sie eine verständliche Meldung geben kann.
    client_max_body_size 8m;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Überschreibt, was der Client schickt: Das Rate Limiting vertraut dieser Adresse.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    # Reihen der Startseite werden gestreamt; Puffern würde sie verzögern.
    proxy_buffering off;

    location /api/auth/sign-in {
        limit_req zone=kinora_login burst=10 nodelay;
        proxy_pass http://kinora_app;
    }

    location /api/auth/ {
        limit_req zone=kinora_auth burst=30 nodelay;
        proxy_pass http://kinora_app;
    }

    location /_next/static/ {
        proxy_pass http://kinora_app;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://kinora_app;
    }
}
