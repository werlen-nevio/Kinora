# Kinora: Konfiguration
# Kopieren nach .env und ausfüllen. Die Datei .env gehört nie ins Repository.

# ---- Pflichtwerte -----------------------------------------------------------

# TMDB-Lesetoken (API Read Access Token, nicht der v3-Key):
# https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=

# Mindestens 32 zufällige Zeichen, z. B.: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Öffentliche Adresse der Anwendung, ohne Schrägstrich am Ende.
BETTER_AUTH_URL=http://localhost:3000

# Passwort der Datenbank in docker-compose.yml. Nur Buchstaben und Ziffern, weil es in
# einer URL steht, z. B.: openssl rand -hex 24
POSTGRES_PASSWORD=

# Nur für die lokale Entwicklung (docker compose up -d db), mit demselben Passwort.
# In Docker setzt Compose den Wert selbst.
DATABASE_URL=postgresql://kinora:PASSWORT@localhost:5432/kinora

# ---- Optional: E-Mail für das Zurücksetzen von Passwörtern --------------------
# Ohne SMTP schreibt die Entwicklung den Link ins Server-Log. In Produktion geschieht
# das nur mit LOG_RESET_LINKS=true: Wer die Logs lesen kann, kann dann Konten übernehmen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kinora <no-reply@example.com>
LOG_RESET_LINKS=false
# Nur für lokale Mail-Relays ohne TLS, sonst muss der SMTP-Server TLS anbieten.
SMTP_ALLOW_PLAINTEXT=false

# ---- Optional: Betrieb --------------------------------------------------------

# Neue Konten erlauben. Sind alle eingerichtet: auf false setzen, dann kann sich
# niemand mehr registrieren, der die Adresse kennt.
ALLOW_SIGNUP=true

# Weitere erlaubte Origins für Auth-Anfragen, kommagetrennt.
TRUSTED_ORIGINS=

# Hintergrundjobs im App-Prozess abschalten (nur bei mehreren App-Instanzen sinnvoll).
DISABLE_WORKER=false
